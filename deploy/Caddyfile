# [INPUT]: 客户端 HTTPS 请求，由 Caddy 自动申请 TLS 证书并反代至 127.0.0.1:8081
# [OUTPUT]: 极简开箱即用的现代化反向代理，内置 upstream read_timeout 130s 保护
# [POS]: deploy/ 的 Caddy 自动化反代配置范本
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

hme.your-domain.com {
    encode gzip zstd

    # 安全响应头
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }

    # 验证码长轮询接口专属保护 (130s > 后端 120s 超时，flush_interval -1 实时直通)
    @verify path /api/verify/code
    handle @verify {
        reverse_proxy 127.0.0.1:8081 {
            transport http {
                read_timeout 130s
            }
            flush_interval -1
        }
    }

    # 前端带 Hash 静态资源长期缓存
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy 127.0.0.1:8081
    }

    # 默认全量反代
    handle {
        reverse_proxy 127.0.0.1:8081
    }
}
