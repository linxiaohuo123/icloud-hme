# ==============================================================================
# iCloud HME 生产环境配置模板 (.env)
# 复制为 .env 后填写。启动脚本会自动加载当前目录与 data/ 目录下的 .env。
# ==============================================================================

# 管理员后台登录密码 (必填)
# 规则: 至少 8 个字符，且禁止使用仓库模板里的占位值(会被拒绝启动)。
# 示例值仅作演示，务必替换为随机强口令，例如:
#   openssl rand -base64 24
ICLOUD_HME_ADMIN_PASSWORD=__CHANGE_ME__

# 自动化外部 API Key (可选)
# 配置后外部脚本可通过 Header: Authorization: Bearer <KEY> 鉴权。
# 该 Key 等同管理员权限；若只想给外部程序「出号+取码」能力，
# 请改用后台「业务标识与令牌」页生成受限作用域令牌(allocate,verify)。
ICLOUD_HME_API_KEY=

# HTTP 监听地址
# 裸机/systemd 部署建议保持回环 127.0.0.1:8081，由 Nginx/Caddy 终止 TLS 后反代。
# 容器部署由 Dockerfile 覆盖为 0.0.0.0:8081。
ICLOUD_HME_ADDR=127.0.0.1:8081

# 是否启用 Cookie Secure 标记 (经过 Nginx / Caddy 反向代理 HTTPS 时务必设为 true)
# 为 false 时会话 Cookie 会以明文 HTTP 传输，公网部署等于泄露管理员会话。
ICLOUD_HME_SECURE_COOKIE=false

# 可信反向代理地址 (逗号分隔的 IP 或 CIDR)，默认留空。
#
# 留空 = 不信任任何代理头，登录限流按**真实连接地址**计数，
#   X-Forwarded-For 无法伪造（最安全）。但经 Nginx/Caddy 反代部署时，
#   所有请求的来源都会变成代理自身 IP，于是 15 分钟 / 5 次的登录限流
#   退化成**全局单桶**: 攻击者只要持续提交错误口令，就能把管理员
#   长期挡在登录页之外（已有会话不受影响）。
#
# 反代部署时请填**仅**代理自身的地址，例如:
#   ICLOUD_HME_TRUSTED_PROXIES=127.0.0.1
#   ICLOUD_HME_TRUSTED_PROXIES=172.17.0.0/16      # Docker 网桥
# 此时 Gin 仅在直连对端属于该列表时才采信 X-Forwarded-For，
# 外部攻击者直连时对端不是代理，伪造的头会被忽略。

# 管理员 Web 会话有效时长 (默认 12h，范围 15m - 168h)
ICLOUD_HME_SESSION_TTL=12h

# Cookie 失效后台探测周期 (默认 30m，范围 5m - 24h)
ICLOUD_HME_COOKIE_MONITOR_INTERVAL=30m

# ── 以下三项留空即"自动"，通常无需配置 ──────────────────────────────────────
# 账号数上千时必须了解这三个值的作用，否则容易对 Apple 形成过大压力。

# Cookie 校验的账号间节流间隔。
# 留空 = 自动摊平：按 ICLOUD_HME_COOKIE_MONITOR_INTERVAL / 账号数 计算，
#   使一轮校验正好落在周期之内（2000 账号 → 约 900ms）。
#   固定值会让 2000 账号一轮耗时 66 分钟 > 30 分钟周期，退化成 7×24 连续探测 Apple。
# 显式设置时范围 [50ms, 5m]。
# ICLOUD_HME_COOKIE_THROTTLE=900ms

# 启动预热时账号之间的提交间隔。
# 留空 = 自动摊平到约 10 分钟（2000 账号 → 约 300ms）。
# 显式设置时范围 [50ms, 5m]。
# ICLOUD_HME_STARTUP_SYNC_INTERVAL=300ms

# 取码长轮询期间的邮件轮询周期 (仅在确有订阅者时才会轮询)，默认 2s，范围 [500ms, 1m]。
# ICLOUD_HME_MAIL_POLL_INTERVAL=2s

# ── 数据保留 ────────────────────────────────────────────────────────────────
# 已用别名流水的保留期，支持天数写法（如 180d）或标准时长（如 4320h）。
# 留空/不设 = 永久保留（保持历史行为）。
# 几千账号规模下流水可达每天数万条（数千万条/年），建议按合规要求设置。
# 注意：清理只删流水，**不影响别名路由表**（取码链路依赖它长期保留）。
# 下限 24h，防止误配成极短周期把近期流水删掉。
# ICLOUD_HME_LEASE_RETENTION=180d
