# Runtime data (含明文 Apple Cookie / App 专用密码)
/data/
/logs/

# Environment
/.env
/.env.*
!/.env.example

# Build artifacts
/build/
*.exe
*.exe~
/icloud-hme
/icloud-hme-linux-amd64
# 发布产物命名用下划线(release.yml / systemd 单元按此命名)，必须逐个列出:
