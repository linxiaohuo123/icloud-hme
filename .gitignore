/icloud-hme_linux_amd64
/icloud-hme_linux_arm64
/icloud-hme_darwin_amd64
/icloud-hme_darwin_arm64

# Web frontend build output & deps
/web/node_modules/
/internal/webui/dist/*
!/internal/webui/dist/placeholder.txt

# Legacy account files
accounts.json
accounts.json.bak
accounts.json.migrated
*.db
*.db-wal
*.db-shm

